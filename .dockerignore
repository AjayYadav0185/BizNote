# VCS / CI
.git/
.github/

# Dart / Flutter tooling & caches
.dart_tool/
**/pubspec_overrides.yaml

# Local build artifacts are rebuilt inside the Docker image. The APK is
# regenerated there and then copied into the final nginx image.
build/
logs/
coverage/

# Test suite (not needed to build the web app)
test/

# IDE / OS cruft
.idea/
*.iml
.vscode/
.DS_Store

# Android sources are required to regenerate the downloadable APK.
# Machine-local SDK paths and generated IDE state must not enter the image.
android/local.properties
android/.gradle/
