server {
    listen ${PORT};
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/plain
               text/css
               application/javascript
               application/json
               image/svg+xml
               application/wasm;

    # Bare /app -> /app/
    location = /app {
        return 301 /app/;
    }

    # Flutter web app (built with --base-href /app/).
    location /app/ {
        try_files $uri $uri/ /app/index.html;
    }

    # APK download - always served as a file attachment.
    location /apk/ {
        add_header Content-Disposition "attachment; filename=BizNote.apk" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # Landing page at the site root.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
